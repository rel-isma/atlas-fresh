# Copy this file to .env and fill in real values.
# .env itself must never be committed — it's already covered by the
# repo's root .gitignore (the ".env" pattern matches at any depth,
# so backend/.env is excluded automatically).

# Optional. Enables the real LLM assistant provider
# (app/core/assistant/provider.py: LLMProvider). If unset, the app
# runs fully on the deterministic FallbackProvider — no functionality
# is lost, /api/plan and /api/assistant both work either way.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6
